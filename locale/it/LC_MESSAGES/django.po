#: templates/account/password_reset.html:5
#: templates/account/password_reset.html:17
#: templates/account/password_reset_done.html:5
#: templates/account/password_reset_done.html:8
msgid "Password Reset"
msgstr "Reset Password"

#: templates/account/password_reset.html:23
msgid ""
"Forgotten your password? Enter your email address below, and we'll send you "
"an email allowing you to reset it."
msgstr ""
"Password dimenticata? Inserisci il tuo indirizzo email qua sotto e riceverai "
"una email con il link per resettare la tua password."

#: templates/account/password_reset.html:32
msgid "Reset My Password"
msgstr "Resetta la mia password"

#: templates/account/password_reset.html:35
msgid "Please contact us if you have any trouble resetting your password."
msgstr "Per favore contattaci se hai problemi a resecare la tua password."

#: templates/account/password_reset_done.html:13
msgid ""
"We have sent you an email. If you have not received it please check your "
"spam folder. Otherwise contact us if you do not receive it in a few minutes."
msgstr ""
"Ti abbiamo inviato una email. Se non l'hai ricevuta controlla nella cartella "
"spam. Altrimenti contattaci se non la ricevi entro qualche minuto."

