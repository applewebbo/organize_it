#!/usr/bin/env bash
set -euo pipefail

# Codeberg CLI - Generic script for managing issues via Forgejo API
# Usage: ./bin/codeberg <command> [args]

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get script directory and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Read API token from .env
if [[ ! -f "$PROJECT_ROOT/.env" ]]; then
    echo -e "${RED}Error: .env file not found${NC}" >&2
    exit 1
fi

CODEBERG_TOKEN=$(grep "^CODEBERG_API_TOKEN=" "$PROJECT_ROOT/.env" | cut -d'=' -f2)
if [[ -z "$CODEBERG_TOKEN" ]]; then
    echo -e "${RED}Error: CODEBERG_API_TOKEN not found in .env${NC}" >&2
    exit 1
fi

# Auto-detect repository from git remote
detect_repo() {
    local remote_url
    remote_url=$(git -C "$PROJECT_ROOT" remote get-url origin 2>/dev/null || echo "")

    if [[ -z "$remote_url" ]]; then
        echo -e "${RED}Error: No git remote found${NC}" >&2
        exit 1
    fi

    # Extract owner/repo from various URL formats
    if [[ "$remote_url" =~ codeberg.org[:/]([^/]+)/([^/.]+) ]]; then
        REPO_OWNER="${BASH_REMATCH[1]}"
        REPO_NAME="${BASH_REMATCH[2]}"
    else
        echo -e "${RED}Error: Could not parse Codeberg repository from remote URL: $remote_url${NC}" >&2
        exit 1
    fi
}

# API base URL
API_BASE="https://codeberg.org/api/v1"

# Make API request
api_request() {
    local method=$1
    local endpoint=$2
    local data=${3:-}

    local curl_opts=(
        -s
        -X "$method"
        -H "Authorization: token $CODEBERG_TOKEN"
        -H "Content-Type: application/json"
    )

    if [[ -n "$data" ]]; then
        curl_opts+=(-d "$data")
    fi

    curl "${curl_opts[@]}" "$API_BASE$endpoint"
}

# Commands
cmd_list() {
    local state=${1:-open}
    detect_repo

    echo -e "${GREEN}Fetching $state issues for $REPO_OWNER/$REPO_NAME...${NC}"
    api_request GET "/repos/$REPO_OWNER/$REPO_NAME/issues?state=$state" | \
        python3 -c "
import sys, json
issues = json.load(sys.stdin)
for issue in issues:
    labels = ', '.join([l['name'] for l in issue.get('labels', [])])
    print(f\"#{issue['number']}: {issue['title']}\")
    if labels:
        print(f\"  Labels: {labels}\")
    print()
"
}

cmd_show() {
    local issue_num=$1
    detect_repo

    echo -e "${GREEN}Fetching issue #$issue_num...${NC}"
    api_request GET "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num" | \
        python3 -c "
import sys, json
issue = json.load(sys.stdin)
print(f\"Issue #{issue['number']}: {issue['title']}\")
print(f\"State: {issue['state']}\")
print(f\"Created: {issue['created_at']}\")
print(f\"Updated: {issue['updated_at']}\")
labels = ', '.join([l['name'] for l in issue.get('labels', [])])
if labels:
    print(f\"Labels: {labels}\")
print(f\"\\nDescription:\\n{issue['body'] or '(empty)'}\")
print(f\"\\nComments: {issue['comments']}\")
"

    # Show comments if any
    local comments
    comments=$(api_request GET "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num/comments")
    echo "$comments" | python3 -c "
import sys, json
comments = json.load(sys.stdin)
if comments:
    print('\\n--- Comments ---')
    for i, comment in enumerate(comments, 1):
        print(f\"\\nComment #{i} by {comment['user']['login']} at {comment['created_at']}:\")
        print(comment['body'])
"
}

cmd_comment() {
    local issue_num=$1
    shift
    local comment_text="$*"

    if [[ -z "$comment_text" ]]; then
        echo -e "${RED}Error: Comment text required${NC}" >&2
        exit 1
    fi

    detect_repo

    local data
    data=$(CB_BODY="$comment_text" python3 -c "import json, os; print(json.dumps({'body': os.environ['CB_BODY']}))")

    echo -e "${GREEN}Adding comment to issue #$issue_num...${NC}"
    api_request POST "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num/comments" "$data" >/dev/null
    echo -e "${GREEN}✓ Comment added${NC}"
}

cmd_close() {
    local issue_num=$1
    detect_repo

    echo -e "${GREEN}Closing issue #$issue_num...${NC}"
    api_request PATCH "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num" '{"state":"closed"}' >/dev/null
    echo -e "${GREEN}✓ Issue closed${NC}"
}

cmd_reopen() {
    local issue_num=$1
    detect_repo

    echo -e "${GREEN}Reopening issue #$issue_num...${NC}"
    api_request PATCH "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num" '{"state":"open"}' >/dev/null
    echo -e "${GREEN}✓ Issue reopened${NC}"
}

cmd_label() {
    local issue_num=$1
    shift
    local labels=("$@")

    if [[ ${#labels[@]} -eq 0 ]]; then
        echo -e "${RED}Error: At least one label required${NC}" >&2
        exit 1
    fi

    detect_repo

    # Get all repo labels to resolve names -> IDs
    local repo_labels
    repo_labels=$(api_request GET "/repos/$REPO_OWNER/$REPO_NAME/labels?limit=50")

    # Resolve label names to IDs
    local label_ids
    label_ids=$(CB_REPO_LABELS="$repo_labels" python3 -c "
import json, os, sys
repo_labels = json.loads(os.environ['CB_REPO_LABELS'])
name_to_id = {l['name'].lower(): l['id'] for l in repo_labels}
requested = sys.argv[1:]
ids = []
missing = []
for name in requested:
    lid = name_to_id.get(name.lower())
    if lid is not None:
        ids.append(lid)
    else:
        missing.append(name)
if missing:
    import sys as _sys
    print(f'Warning: labels not found in repo: {missing}', file=_sys.stderr)
print(json.dumps({'labels': ids}))
" "${labels[@]}")

    if [[ -z "$label_ids" || "$label_ids" == '{"labels": []}' ]]; then
        echo -e "${RED}Error: None of the specified labels exist in the repository${NC}" >&2
        exit 1
    fi

    echo -e "${GREEN}Adding labels to issue #$issue_num...${NC}"
    api_request POST "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num/labels" "$label_ids" >/dev/null
    echo -e "${GREEN}✓ Labels added: ${labels[*]}${NC}"
}

cmd_check() {
    local issue_num=$1
    shift
    local step_text="$*"

    if [[ -z "$step_text" ]]; then
        echo -e "${RED}Error: Step text required${NC}" >&2
        exit 1
    fi

    detect_repo

    # Fetch current body
    local current_body
    current_body=$(api_request GET "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num" | \
        python3 -c "import sys, json; print(json.load(sys.stdin).get('body') or '')")

    # Replace - [ ] step with - [x] step
    local new_body
    new_body=$(CB_BODY="$current_body" CB_STEP="$step_text" python3 -c "
import os
body = os.environ['CB_BODY']
step = os.environ['CB_STEP']
old = f'- [ ] {step}'
new = f'- [x] {step}'
if old not in body:
    import sys
    print(f'Error: step not found: {step}', file=sys.stderr)
    sys.exit(1)
print(body.replace(old, new, 1))
")

    local data
    data=$(CB_BODY="$new_body" python3 -c "import json, os; print(json.dumps({'body': os.environ['CB_BODY']}))")

    echo -e "${GREEN}Marking step as done in issue #$issue_num...${NC}"
    api_request PATCH "/repos/$REPO_OWNER/$REPO_NAME/issues/$issue_num" "$data" >/dev/null
    echo -e "${GREEN}✓ Step checked: $step_text${NC}"
}

cmd_create() {
    local title="$1"
    shift
    local body
    body=$(printf "%b" "${*:-}")

    if [[ -z "$title" ]]; then
        echo -e "${RED}Error: Title required${NC}" >&2
        exit 1
    fi

    detect_repo

    local data
    data=$(CB_TITLE="$title" CB_BODY="$body" python3 -c "import json, os; print(json.dumps({'title': os.environ['CB_TITLE'], 'body': os.environ['CB_BODY']}))")

    echo -e "${GREEN}Creating issue...${NC}"
    local response
    response=$(api_request POST "/repos/$REPO_OWNER/$REPO_NAME/issues" "$data")
    local issue_num
    issue_num=$(echo "$response" | python3 -c "import sys, json; print(json.load(sys.stdin)['number'])")
    echo -e "${GREEN}✓ Issue #$issue_num created${NC}"
}

cmd_help() {
    cat <<EOF
${GREEN}Codeberg CLI${NC} - Manage issues via Forgejo API

${YELLOW}Usage:${NC}
  codeberg <command> [args]

${YELLOW}Commands:${NC}
  list [state]              List issues (state: open|closed|all, default: open)
  show <number>             Show issue details and comments
  comment <number> <text>   Add comment to issue
  check <number> <step>     Mark a checkbox step as done in issue body
  close <number>            Close issue
  reopen <number>           Reopen issue
  label <number> <labels>   Add labels to issue (space-separated)
  create <title> [body]     Create new issue
  help                      Show this help

${YELLOW}Examples:${NC}
  codeberg list
  codeberg list closed
  codeberg show 32
  codeberg comment 32 "Fixed in commit abc123"
  codeberg check 32 "Add migration"
  codeberg close 32
  codeberg label 32 bug enhancement
  codeberg create "New feature" "Description here"

${YELLOW}Setup:${NC}
  1. Add CODEBERG_API_TOKEN to .env file
  2. Script auto-detects repository from git remote
  3. Works with any Codeberg repository

EOF
}

# Main
main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 0
    fi

    local command=$1
    shift

    case "$command" in
        list)
            cmd_list "$@"
            ;;
        show)
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Error: Issue number required${NC}" >&2
                exit 1
            fi
            cmd_show "$@"
            ;;
        comment)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}Error: Issue number and comment text required${NC}" >&2
                exit 1
            fi
            cmd_comment "$@"
            ;;
        check)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}Error: Issue number and step text required${NC}" >&2
                exit 1
            fi
            cmd_check "$@"
            ;;
        close)
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Error: Issue number required${NC}" >&2
                exit 1
            fi
            cmd_close "$@"
            ;;
        reopen)
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Error: Issue number required${NC}" >&2
                exit 1
            fi
            cmd_reopen "$@"
            ;;
        label)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}Error: Issue number and at least one label required${NC}" >&2
                exit 1
            fi
            cmd_label "$@"
            ;;
        create)
            if [[ $# -eq 0 ]]; then
                echo -e "${RED}Error: Issue title required${NC}" >&2
                exit 1
            fi
            cmd_create "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            echo -e "${RED}Error: Unknown command '$command'${NC}" >&2
            echo "Run 'codeberg help' for usage" >&2
            exit 1
            ;;
    esac
}

main "$@"
